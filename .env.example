# ===========================================================================
#  .env.example -> PLANTILLA de las variables de entorno.
#
#  El fichero .env real no se sube al repositorio porque lleva contraseñas
#  (está en el .gitignore). Para poner en marcha el proyecto hay que copiar
#  este fichero y quitarle el ".example" del nombre:
#
#     Windows:  copy .env.example .env
#     Linux:    cp .env.example .env
#
#  Los valores de abajo son los que crea el docker-compose.yaml, así que
#  funcionan tal cual, sin cambiar nada.
# ===========================================================================

# Puerto en el que escucha la API de Express
PORT=3000

# Dirección de la API (informativa, el front la tiene en src/api/*.js)
API_URL="http://localhost:3000/api"

# Conexión con MongoDB:
#   admin:abc123     -> usuario y contraseña definidos en docker-compose.yaml
#   localhost:27017  -> el contenedor publica el puerto 27017 en nuestro PC
#   /bbdd            -> nombre de la base de datos que se usará
#   authSource=admin -> dónde están guardadas las credenciales
MONGO_URI="mongodb://admin:abc123@localhost:27017/bbdd?authSource=admin"
