# Puerto en el que escucha Express. Los ficheros de src/api/ apuntan a este.
PORT=3000

# Conexion a MongoDB. Usuario y clave son los del docker-compose.yaml.
# authSource=admin indica donde estan las credenciales; bbdd es la base de datos.
MONGO_URI=mongodb://admin:abc123@localhost:27017/bbdd?authSource=admin
